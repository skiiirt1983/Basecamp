menu "Basecamp launcher"

    config BASECAMP_SLOT0_NAME
        string "ota_0 display name"
        default "PrintSphere"
    config BASECAMP_SLOT1_NAME
        string "ota_1 display name"
        default "Capsule Radar"
    config BASECAMP_SLOT2_NAME
        string "ota_2 display name"
        default "LyricFlash"

    config BASECAMP_SLOT0_VERSION
        string "ota_0 version label if the app descriptor is generic"
        default ""
    config BASECAMP_SLOT1_VERSION
        string "ota_1 version label if the app descriptor is generic"
        default "v1.6.0"
        help
            Arduino builds carry project_name "arduino-lib-builder" and the
            lib-builder git hash as version, so the real version can't be read
            from esp_app_desc_t. This label is shown instead (marked with "*").
    config BASECAMP_SLOT2_VERSION
        string "ota_2 version label if the app descriptor is generic"
        default ""

    config BASECAMP_VERIFY_SLOTS
        bool "Fully verify each slot image (SHA-256) before showing it as bootable"
        default y
        help
            Adds roughly 100-200 ms per populated slot to launcher start-up.
            When disabled, only the image header and app descriptor are checked
            (the bootloader still verifies before booting).


    menu "App sources (GitHub releases)"
        config BASECAMP_SLOT0_REPO
            string "ota_0 GitHub repo (owner/repo)"
            default "cptkirki/PrintSphere"
        config BASECAMP_SLOT0_ASSET_PREFIX
            string "ota_0 asset name starts with"
            default "printsphere_ota"
        config BASECAMP_SLOT0_ASSET_SUFFIX
            string "ota_0 asset name ends with"
            default ".bin"
        config BASECAMP_SLOT0_PROJECT
            string "ota_0 project_name must contain"
            default "printsphere"

        config BASECAMP_SLOT1_REPO
            string "ota_1 GitHub repo (owner/repo)"
            default "socquique/capsule-radar"
        config BASECAMP_SLOT1_ASSET_PREFIX
            string "ota_1 asset name starts with"
            default "CapsuleRadar-ota.bin"
        config BASECAMP_SLOT1_ASSET_SUFFIX
            string "ota_1 asset name ends with"
            default ".bin"
        config BASECAMP_SLOT1_PROJECT
            string "ota_1 project_name must contain"
            default "arduino-lib-builder"
            help
                Capsule Radar is an Arduino build; its descriptor is generic.

        config BASECAMP_SLOT2_REPO
            string "ota_2 GitHub repo (owner/repo)"
            default "skiiirt1983/LyricFlash"
        config BASECAMP_SLOT2_ASSET_PREFIX
            string "ota_2 asset name starts with"
            default "lyricflash-ota.bin"
        config BASECAMP_SLOT2_ASSET_SUFFIX
            string "ota_2 asset name ends with"
            default ".bin"
        config BASECAMP_SLOT2_PROJECT
            string "ota_2 project_name must contain"
            default "lyricflash"
    endmenu

endmenu
